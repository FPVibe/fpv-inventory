{
  "openapi": "3.1.0",
  "info": {
    "title": "fpv-inventory",
    "version": "1.0.0",
    "description": "FPV quad parts, builds, and gear inventory API — part of the FPVibe federation of tools."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local / self-hosted (Runtipi)"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "version", "name"],
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "version": { "type": "string", "example": "1.0.0" },
                    "name": { "type": "string", "example": "fpv-inventory" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "operationId": "getOpenApiSpec",
        "summary": "OpenAPI spec (this document)",
        "tags": ["meta"],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "OpenAPI 3.1.0 specification object"
                }
              }
            }
          }
        }
      }
    },
    "/api/parts": {
      "get": {
        "operationId": "listParts",
        "summary": "List inventory parts",
        "description": "Returns all parts matching the given filters. Unknown type or status values return an empty array rather than an error.",
        "tags": ["parts"],
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filter by part type",
            "schema": { "$ref": "#/components/schemas/PartType" }
          },
          {
            "name": "status",
            "in": "query",
            "description": "Filter by status",
            "schema": { "$ref": "#/components/schemas/PartStatus" }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive substring search on name",
            "schema": { "type": "string" }
          },
          {
            "name": "parent_id",
            "in": "query",
            "description": "Filter by parent assembly ID. Use 0 to get top-level parts (parent_id IS NULL). Negative or non-integer values are ignored.",
            "schema": { "type": "integer", "minimum": 0 }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of matching parts (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Part" }
                }
              }
            }
          }
        }
      }
    },
    "/api/parts/{id}": {
      "get": {
        "operationId": "getPart",
        "summary": "Get part with history",
        "tags": ["parts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Part with full history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PartWithHistory" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/builds": {
      "get": {
        "operationId": "listBuilds",
        "summary": "List builds",
        "description": "Returns top-level parts with type=craft. Nested crafts (parent_id set) are excluded.",
        "tags": ["builds"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/PartStatus" }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive substring search on name",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of build parts (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Part" }
                }
              }
            }
          }
        }
      }
    },
    "/api/builds/{id}": {
      "get": {
        "operationId": "getBuild",
        "summary": "Get build with components",
        "description": "Returns a top-level craft part with its direct children. 404 if the id belongs to a non-craft part or a nested craft.",
        "tags": ["builds"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Build part with children",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Build" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/builds/{id}/bom": {
      "get": {
        "operationId": "getBuildBom",
        "summary": "Get build BOM with allocation data",
        "description": "Returns the build's direct children with per-component on-hand / allocated / free figures for the component's name+type group.",
        "tags": ["builds"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Array of BOM entries (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/BomItem" }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/parts/{id}/allocation": {
      "get": {
        "operationId": "getPartAllocation",
        "summary": "Get part allocation summary",
        "description": "Returns on-hand / allocated / free figures for the part's name+type group, plus the builds it is installed in. Allocation groups rows by matching name and type.",
        "tags": ["parts"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Allocation summary for the part's group",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Allocation" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/gear": {
      "get": {
        "operationId": "listGear",
        "summary": "List gear",
        "description": "Returns parts with type=gear. Unknown status values return an empty array rather than an error.",
        "tags": ["gear"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": { "$ref": "#/components/schemas/PartStatus" }
          },
          {
            "name": "q",
            "in": "query",
            "description": "Case-insensitive substring search on name",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Array of matching gear parts (may be empty)",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Part" }
                }
              }
            }
          }
        }
      }
    },
    "/api/gear/{id}": {
      "get": {
        "operationId": "getGear",
        "summary": "Get gear with history",
        "description": "Returns a single gear part with its full history. 404 if the id belongs to a non-gear part.",
        "tags": ["gear"],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Gear part with full history",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PartWithHistory" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/stock": {
      "get": {
        "operationId": "getStock",
        "summary": "Aggregate stock by type and status",
        "description": "Returns every part grouped by type and status with summed quantities. All types are included (craft, gear, etc.); consumers filter as needed.",
        "tags": ["stock"],
        "responses": {
          "200": {
            "description": "Array of type × status aggregates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/StockRow" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PartType": {
        "type": "string",
        "enum": [
          "motor",
          "fc",
          "esc",
          "vtx",
          "frame",
          "camera",
          "antenna",
          "battery",
          "craft",
          "gear",
          "other"
        ],
        "description": "Part type category"
      },
      "PartStatus": {
        "type": "string",
        "enum": ["unused", "in-use", "broken", "retired", "lost"],
        "description": "Lifecycle status of the part"
      },
      "Part": {
        "type": "object",
        "required": ["id", "name", "status", "quantity", "created_at", "updated_at"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "status": { "$ref": "#/components/schemas/PartStatus" },
          "type": {
            "oneOf": [{ "$ref": "#/components/schemas/PartType" }, { "type": "null" }],
            "description": "Null if not categorised"
          },
          "notes": { "type": ["string", "null"] },
          "specs": {
            "type": ["string", "null"],
            "description": "Free-form spec block from product listing"
          },
          "quantity": { "type": "integer", "minimum": 0 },
          "parent_id": {
            "type": ["integer", "null"],
            "description": "ID of parent assembly; null for top-level parts"
          },
          "photo_path": {
            "type": ["string", "null"],
            "description": "Filename relative to PHOTOS_DIR"
          },
          "serial_number": { "type": ["string", "null"] },
          "warranty_expiry": {
            "type": ["string", "null"],
            "format": "date",
            "description": "ISO 8601 date (YYYY-MM-DD)"
          },
          "purchase_date": { "type": ["string", "null"], "format": "date" },
          "purchase_price": {
            "type": ["number", "null"],
            "description": "Purchase price in the user's local currency"
          },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "HistoryEntry": {
        "type": "object",
        "required": ["id", "part_id", "action", "created_at"],
        "properties": {
          "id": { "type": "integer" },
          "part_id": { "type": "integer" },
          "action": {
            "type": "string",
            "enum": ["created", "updated", "moved"]
          },
          "from_parent_id": { "type": ["integer", "null"] },
          "to_parent_id": { "type": ["integer", "null"] },
          "old_status": { "type": ["string", "null"] },
          "new_status": { "type": ["string", "null"] },
          "quantity_delta": { "type": ["integer", "null"] },
          "notes": { "type": ["string", "null"] },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "PartWithHistory": {
        "allOf": [
          { "$ref": "#/components/schemas/Part" },
          {
            "type": "object",
            "required": ["history"],
            "properties": {
              "history": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/HistoryEntry" }
              }
            }
          }
        ]
      },
      "BuildChild": {
        "type": "object",
        "required": ["id", "name", "status", "quantity"],
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "type": {
            "oneOf": [{ "$ref": "#/components/schemas/PartType" }, { "type": "null" }]
          },
          "status": { "$ref": "#/components/schemas/PartStatus" },
          "quantity": { "type": "integer" },
          "specs": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      },
      "Build": {
        "allOf": [
          { "$ref": "#/components/schemas/Part" },
          {
            "type": "object",
            "required": ["children"],
            "properties": {
              "children": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/BuildChild" },
                "description": "Direct child components of this build"
              }
            }
          }
        ]
      },
      "StockRow": {
        "type": "object",
        "required": ["type", "status", "total_quantity", "count"],
        "properties": {
          "type": {
            "oneOf": [{ "$ref": "#/components/schemas/PartType" }, { "type": "null" }],
            "description": "Null if not categorised"
          },
          "status": { "$ref": "#/components/schemas/PartStatus" },
          "total_quantity": { "type": "integer", "description": "Summed quantity in this group" },
          "count": { "type": "integer", "description": "Number of rows in this group" }
        }
      },
      "AllocationBuild": {
        "type": "object",
        "required": ["build_id", "build_name", "qty"],
        "properties": {
          "build_id": { "type": "integer" },
          "build_name": { "type": "string" },
          "qty": { "type": "integer", "description": "Quantity installed in this build" }
        }
      },
      "Allocation": {
        "type": "object",
        "required": ["part_id", "part_name", "on_hand", "allocated", "free", "builds"],
        "properties": {
          "part_id": { "type": "integer" },
          "part_name": { "type": "string" },
          "on_hand": {
            "type": "integer",
            "description": "Total quantity across all rows with the same name and type"
          },
          "allocated": {
            "type": "integer",
            "description": "Quantity installed in builds"
          },
          "free": { "type": "integer", "description": "on_hand minus allocated" },
          "builds": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AllocationBuild" },
            "description": "Builds this part is installed in"
          }
        }
      },
      "BomItem": {
        "type": "object",
        "required": [
          "part_id",
          "part_name",
          "qty_in_build",
          "role",
          "on_hand",
          "allocated",
          "free"
        ],
        "properties": {
          "part_id": { "type": "integer" },
          "part_name": { "type": "string" },
          "part_type": {
            "oneOf": [{ "$ref": "#/components/schemas/PartType" }, { "type": "null" }]
          },
          "qty_in_build": { "type": "integer", "description": "Quantity used by this build" },
          "role": {
            "type": ["string", "null"],
            "description": "Role of the component within the build; null when not assigned"
          },
          "on_hand": { "type": "integer" },
          "allocated": { "type": "integer" },
          "free": { "type": "integer" }
        }
      }
    },
    "responses": {
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": ["error"],
              "properties": {
                "error": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
